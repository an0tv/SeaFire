[Unit]
Description=Seafire Stereo Bioluminescence Recorder
After=local-fs.target
Wants=v4l2.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/rpi/Documents/SeaFire

# ── Mount any SSD ────────────────────────────────────────────────────────
ExecStartPre=-/bin/sh /home/rpi/Documents/SeaFire/mount_ssd.sh
ExecStartPre=/bin/sh -c 'mkdir -p /media/rpi/SSD/seafire_recordings'

# ── Wait for cameras ─────────────────────────────────────────────────────
ExecStartPre=-/bin/sh -c 'echo "[seafire] checking cameras..."; \
  while true; do \
    count=$(v4l2-ctl --list-devices 2>/dev/null | grep -c Arducam || true); \
    if [ "$count" -ge 2 ]; then \
      echo "[seafire]   $count Arducam(s) found"; \
      break; \
    fi; \
    echo "[seafire]   $count Arducam(s), waiting for 2+..."; \
    sleep 5; \
  done'

# ── Run ──────────────────────────────────────────────────────────────────
ExecStart=/usr/bin/python3 -u /home/rpi/Documents/SeaFire/main.py

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=seafire

[Install]
WantedBy=multi-user.target
